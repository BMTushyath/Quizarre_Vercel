# ─────────────────────────────────────────────
# Quizarre Hybrid Deployment Environment Configuration
# ─────────────────────────────────────────────

# Port for backend service (set automatically by Railway/Render)
PORT=8000

# Genuine Shared Redis (e.g. Upstash, Redis Cloud, Railway Redis)
# Leave unset or empty to fall back to in-memory FakeRedis
REDIS_URL=redis://default:your_redis_password@your-redis-host:6379

# Persistent PostgreSQL (e.g. Neon, Supabase, Railway Postgres)
# Leave unset or empty to fall back to local SQLite (quiz.db)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Allowed CORS Origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*
